@page "/game/{GameId:int}"
@using System.Net.Http.Json
@using Puissance4API.DTO
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<style>
    .game-title {
        font-size: 1.8rem;
        font-weight: bold;
        color: #333;
        text-align: center;
        margin-bottom: 1rem;
    }
    .game-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 1rem;
        border: 1px solid #ccc;
        border-radius: 10px;
        background-color: #f9f9f9;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
    .game-info {
        margin-bottom: 1.5rem;
        font-size: 1rem;
    }
    .column-buttons {
        display: flex;
        justify-content: space-between;
        margin-bottom: 1.5rem;
    }
    .column-button {
        padding: 0.5rem 1rem;
        font-size: 1rem;
        background-color: #007BFF;
        color: #fff;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        transition: background-color 0.3s;
    }
    .column-button:disabled {
        background-color: #ccc;
        cursor: not-allowed;
    }
    .column-button:hover:not(:disabled) {
        background-color: #0056b3;
    }
    .game-board {
        display: grid;
        grid-template-rows: repeat(6, 50px);
        grid-template-columns: repeat(7, 50px);
        gap: 5px;
        justify-content: center;
        margin-bottom: 1.5rem;
    }
    .row {
        display: flex;
    }
    .cell {
        width: 50px;
        height: 50px;
        border: 1px solid #ddd;
        background-color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 5px;
    }
    .token {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: inline-block;
    }
    .actions {
        text-align: center;
    }
    .leave-button {
        padding: 0.5rem 1.5rem;
        font-size: 1rem;
        background-color: #dc3545;
        color: #fff;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        transition: background-color 0.3s;
    }
    .leave-button:hover {
        background-color: #a71d2a;
    }
</style>

<h3 class="game-title">Puissance 4 - Détails de la partie</h3>

@if (gameinprogress == null)
{
    <p>Chargement des données...</p>
}
else
{
    <div class="game-container">
        <!-- Informations sur le jeu -->
        <div class="game-info">
            <p><strong>Status :</strong> @gameinprogress.Status</p>
            <p><strong>Hôte :</strong> @gameinprogress.Host.Login</p>
            @if (gameinprogress.Guest != null)
            {
                <p><strong>Invité :</strong> @gameinprogress.Guest.Login</p>
            }
            else
            {
                <p><em>En attente d'un invité...</em></p>
            }
        </div>

        <!-- Boutons pour jouer -->
        <div class="column-buttons">
            @for (int col = 0; col < 7; col++)
            {
                <button class="column-button"
                        @onclick="() => PlayTurn(col)"
                        disabled="@IsColumnDisabled(col)">
                    Colonne @col
                </button>
            }
        </div>

        <!-- Grille de jeu -->
        <div class="game-board">
            @for (int row = 0; row < 6; row++)
            {
                @for (int col = 0; col < 7; col++)
                {
                    var cell = gameinprogress.Grid.Cells.FirstOrDefault(c => c.Row == row && c.Column == col);
                    <div class="cell">
                        @if (cell?.Token != null)
                        {
                            <span class="token" style="background-color: @cell.Token.Color"></span>
                        }
                    </div>
                }
            }
        </div>

        <!-- Boutons d'actions -->
        <div class="actions">
            @if (gameinprogress.Status == "InProgress")
            {
                <button class="leave-button" @onclick="LeaveGame">Quitter la partie</button>
            }
        </div>
    </div>
}
@code {
    [Parameter] public int GameId { get; set; }
    public InProgressGameDto? gameinprogress;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            gameinprogress = await Http.GetFromJsonAsync<InProgressGameDto>($"api/Games/{GameId}");
            if (gameinprogress == null)
            {
                await alert("Partie introuvable !");
                NavigationManager.NavigateTo("/games");
            }
        }
        catch (Exception ex)
        {
            await alert($"Erreur de chargement : {ex.Message}");
            NavigationManager.NavigateTo("/games");
        }
    }

    private async Task PlayTurn(int column)
    {
        if (gameinprogress == null || gameinprogress.Status != "InProgress")
        {
            await alert("La partie n'est pas active !");
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync($"api/Games/{gameinprogress.Id}/play", new { Column = column });
            if (response.IsSuccessStatusCode)
            {
                gameinprogress = await Http.GetFromJsonAsync<InProgressGameDto>($"api/Games/{gameinprogress.Id}");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Console.WriteLine(error);
                await alert($"Erreur : {error}");
            }
        }
        catch (Exception ex)
        {
            await alert($"Impossible de jouer : {ex.Message}");
        }
    }

    private void LeaveGame()
    {
        NavigationManager.NavigateTo("/games");
    }

    private bool IsColumnDisabled(int column)
    {
        if (gameinprogress.Status != "InProgress" || gameinprogress.Guest == null)
        {
            return true;
        }

        return GetAvailableRow(column) == -1; // Désactiver si la colonne est pleine.
    }

    private int GetAvailableRow(int column)
    {
        for (int row = 5; row >= 0; row--)
        {
            var cell = gameinprogress.Grid.Cells.FirstOrDefault(c => c.Row == row && c.Column == column);
            if (cell != null && cell.Token == null)
            {
                return row;
            }
        }

        return -1;
    }

    private async Task alert(string message)
    {
        await JSRuntime.InvokeVoidAsync("alert", message);
    }
}

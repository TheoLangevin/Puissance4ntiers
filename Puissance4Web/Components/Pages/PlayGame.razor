@page "/game/{GameId:int}"
@using System.Net.Http.Json
@using Puissance4API.DTO
@using System.IdentityModel.Tokens.Jwt
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage


<style>
    .game-title {
        font-size: 1.8rem;
        font-weight: bold;
        color: #333;
        text-align: center;
        margin-bottom: 1rem;
    }

    .game-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 1rem;
        border: 1px solid #ccc;
        border-radius: 10px;
        background-color: #f9f9f9;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .game-info {
        margin-bottom: 1.5rem;
        font-size: 1rem;
    }

    .column-buttons {
        display: flex;
        justify-content: space-between;
        margin-bottom: 1.5rem;
    }

    .column-button {
        padding: 0.5rem 1rem;
        font-size: 1rem;
        background-color: #007BFF;
        color: #fff;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        transition: background-color 0.3s;
    }

    .column-button:disabled {
        background-color: #ccc;
        cursor: not-allowed;
    }

    .column-button:hover:not(:disabled) {
        background-color: #0056b3;
    }

    .game-board {
        display: grid;
        grid-template-rows: repeat(6, 50px);
        grid-template-columns: repeat(7, 50px);
        gap: 5px;
        justify-content: center;
        margin-bottom: 1.5rem;
    }

    .row {
        display: flex;
    }

    .cell {
        width: 50px;
        height: 50px;
        border: 1px solid #ddd;
        background-color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 5px;
    }

    .token {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: inline-block;
    }

    .actions {
        text-align: center;
    }

    .leave-button {
        padding: 0.5rem 1.5rem;
        font-size: 1rem;
        background-color: #dc3545;
        using Blazored.LocalStorage.Exceptions;
        using Microsoft.VisualBasic;
        color: #fff;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        transition: background-color 0.3s;
    }

    .leave-button:hover {
        background-color: #a71d2a;
    }
</style>

<h3 class="game-title">Puissance 4 - Détails de la partie</h3>

@if (gameinprogress == null)
{
    <p>Chargement des données...</p>
}
else
{
    <div class="game-container">
    <!-- Informations sur le jeu -->
    <div class="game-info">
        <p><strong>Status :</strong> @gameinprogress.Status</p>
        <p><strong>Hôte :</strong> @gameinprogress.Host.Login</p>
        @if (gameinprogress.Guest != null)
            {
                <p><strong>Invité :</strong> @gameinprogress.Guest.Login</p>
            }
            else
            {
                <p><em>En attente d'un invité...</em></p>
            }
        </div>

        <!-- >  ----->

        <!-- Grille de jeu -->
        <div class="game-board">
            @foreach (var row in Enumerable.Range(0, gameinprogress.Grid.Rows))
            {
                @foreach (var col in Enumerable.Range(0, gameinprogress.Grid.Columns))
                {
                    var cell = gameinprogress.Grid.Cells.FirstOrDefault(c => c.Row == row && c.Column == col);
                    <div class="cell" @onclick="() => HandleCellClick(col)">
                        @if (cell?.Token != null)
                        {
                            <span class="token" style="background-color: @(cell.Token)"></span>
                        }
                    </div>
                }
            }
        </div>


        <!-- Boutons d'actions -->
        <div class="actions">
            @if (gameinprogress.Status == "InProgress")
            {
                <button class="leave-button" @onclick="LeaveGame">Quitter la partie</button>
            }
        </div>
    </div>
}
@code {
    [Parameter] public int GameId { get; set; }
    public InProgressGameDto? gameinprogress;
    private bool[] columnStates = new bool[7];
    private bool _isInteractive = false; // Flag pour indiquer si le composant est interactif

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isInteractive = true; // Le composant est maintenant interactif
        }
    }
    protected override async Task OnInitializedAsync()
    {
        try
        {
            gameinprogress = await Http.GetFromJsonAsync<InProgressGameDto>($"api/Games/{GameId}");
            if (gameinprogress == null)
            {
                NavigationManager.NavigateTo("/games");
                return;
            }

            await UpdateColumnStates(); // Préchargez les états des colonnes
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur dans OnInitializedAsync : {ex.Message}");
        }
    }

    private async Task HandleCellClick(int column)
    {
        Console.WriteLine($"Cell clicked in column: {column}");

        // Vérifiez si la colonne est pleine avant de tenter un coup
        if (GetAvailableRow(column) == -1)
        {
            await alert("Cette colonne est pleine !");
            return;
        }

        // Jouez le coup dans la colonne correspondante
        await PlayTurn(column);
    }

    private async Task UpdateColumnStates()
    {
        for (int i = 0; i < 7; i++)
        {
            columnStates[i] = await IsColumnDisabled(i);
        }
        StateHasChanged(); // Forcer le re-rendu
    }

    private async Task PlayTurn(int column)
    {
        if (gameinprogress == null || gameinprogress.Status == "AwaitingGuest" ||
        gameinprogress.Status == "Finished")
        {
            await alert("La partie n'est pas active !");
            return;
        }


        try
        {
            // Ajoutez le token dans le header Authorization
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            // Envoi du coup à l'API
            var response = await Http.PostAsJsonAsync($"api/Games/{gameinprogress.Id}/play", new { Column = column });

            Console.WriteLine($"PlayTurn response: {response.StatusCode}");

            if (response.IsSuccessStatusCode)
            {
                // Rafraîchir les données du jeu
                gameinprogress = await Http.GetFromJsonAsync<InProgressGameDto>($"api/Games/{gameinprogress.Id}");

                // Log dans la console
                var lastMove = gameinprogress.Grid.Cells.FirstOrDefault(c => c.Column == column && c.Token != null);
                if (lastMove != null)
                {
                    Console.WriteLine($"Jeton placé : Joueur {lastMove.Token} en Colonne {column}, Ligne {lastMove.Row}");
                }

                StateHasChanged();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Erreur : {error}");
                await alert($"Erreur : {error}");
            }
        }
        catch (Exception ex)
        {
            await alert($"Impossible de jouer : {ex.Message}");
        }
    }



    private void LeaveGame()
    {
        NavigationManager.NavigateTo("/games");
    }

    private async Task<bool> IsColumnDisabled(int column)
    {
        if (gameinprogress == null || gameinprogress.Status == "Finished" || gameinprogress.Status == "AwaitingGuest")
        {
            return true; // Désactiver si la partie n'est pas active
        }

        var currentPlayerId = await GetCurrentPlayerId();

        var isHostTurn = gameinprogress.Status == "Host's Turn";

        // Vérifier si c'est bien au joueur actuel de jouer
        if ((isHostTurn && currentPlayerId == gameinprogress.Guest?.Id) || // Invité essaie de jouer au tour de l'hôte
        (!isHostTurn && currentPlayerId == gameinprogress.Host.Id)) // Hôte essaie de jouer au tour de l'invité
        {
            return true;
        }

        // Vérifier si la colonne est pleine
        if (GetAvailableRow(column) == -1)
        {
            return true;
        }

        return false; // La colonne est activée si aucune condition ci-dessus n'est remplie
    }


    private int GetAvailableRow(int column)
    {
        for (int row = 5; row >= 0; row--)
        {
            var cell = gameinprogress.Grid.Cells.FirstOrDefault(c => c.Row == row && c.Column == column);
            if (cell != null && cell.Token == null)
            {
                return row; // Retourne l'index de la première ligne disponible.
            }
        }

        return -1; // Retourne -1 si la colonne est pleine.
    }

    private async Task<int> GetCurrentPlayerId()
    {
        var token = await LocalStorage.GetItemAsync<string>("authToken");
        var jwt = new JwtSecurityTokenHandler().ReadJwtToken(token);
        var playerId = jwt.Claims.FirstOrDefault(c => c.Type == "PlayerId")?.Value;

        return int.TryParse(playerId, out var id) ? id : -1;
    }


    private async Task alert(string message)
    {
        if (_isInteractive)
        {
            await JSRuntime.InvokeVoidAsync("alert", message);
        }
        else
        {
            Console.WriteLine($"Alert skipped during prerendering: {message}");
        }
    }
} 
